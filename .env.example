# Production: set these in the hosting provider's secret environment settings.
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1
APP_HOST=your-app.example.com
MAIL_FROM=MoneyApp <noreply@your-app.example.com>
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
DATABASE_URL=postgresql://user:password@host/money_app_production
# Use the existing Rails master key; never commit it.
RAILS_MASTER_KEY=replace-me
SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret

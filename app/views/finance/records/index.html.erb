<div class="finance-heading"><div><p class="eyebrow">お金の管理</p><h1><%= @title %></h1></div><%= link_to "＋ 追加", "#{collection_path}/new", class: "button" %></div>
<section class="finance-card table-wrap"><table><thead><tr><% @fields.each do |key, label, type| %><th><%= label %></th><% end %><th>操作</th></tr></thead><tbody><% @records.each do |record| %><tr><% @fields.each do |key, label, type| %><td><%= finance_field_value(record, key, type) %></td><% end %><td class="actions"><%= link_to "編集", "#{collection_path}/#{record.id}/edit" %><%= button_to "削除", "#{collection_path}/#{record.id}", method: :delete, data: { turbo_confirm: "この記録を削除しますか？" } %></td></tr><% end %></tbody></table><% if @records.empty? %><p class="empty">まだ登録されていません。「追加」から登録できます。</p><% end %></section>

<div class="finance-heading"><div><p class="eyebrow">収入・支出・引き落とし・振替</p><h1>入出金</h1></div><%= link_to "＋ 入出金を記録", new_finance_entry_path, class: "button" %></div>
<%= form_with url: finance_entries_path, method: :get, class: "finance-filters" do |f| %><div><%= f.label :month, "年月" %><%= f.month_field :month, value: params[:month] %></div><div><%= f.label :kind, "区分" %><%= f.select :kind, CashEntry::KINDS, { include_blank: "すべて", selected: params[:kind] } %></div><div><%= f.label :status, "状態" %><%= f.select :status, CashEntry::STATUSES, { include_blank: "すべて", selected: params[:status] } %></div><div><%= f.label :date_order, "日付の並び順" %><%= f.select :date_order, [["新しい順（降順）", "desc"], ["古い順（昇順）", "asc"]], { selected: @date_order } %></div><%= f.submit "適用", class: "button" %><%= link_to "解除", finance_entries_path %><% end %>
<p class="muted"><%= @count %>件 / 金額は支出も正数で表示します。</p>
<section class="finance-card table-wrap"><table><thead><tr><th>日付・曜日</th><th>区分 / 状態</th><th>内容・カテゴリ</th><th>金額</th><th>支払い方法・口座</th><th>備考・カード照合</th><th>操作</th></tr></thead><tbody>
<% @records.each do |entry| %><tr><td class="nowrap"><%= day_label(entry.date) %></td><td><span class="badge"><%= entry.kind %></span><small><%= entry.status %></small></td><td><strong><%= entry.description %></strong><small><%= entry.category %></small></td><td class="amount"><%= money(entry.amount.nil? && entry.card_confirmed_amount.nil? ? nil : @ledger.amount(entry)) %></td><td><%= entry.payment_card&.name || entry.payment_method.presence || "—" %></td><td class="notes"><%= entry.notes %><% if entry.card_debit? && !entry.card_confirmed_amount.nil? %><small>カード確認額：<%= money(entry.card_confirmed_amount) %><br>記録上クレカ合計：<%= money(@ledger.recorded_card_total(entry)) %><br>対象：<%= @ledger.card_period(entry).first %>〜<%= @ledger.card_period(entry).last %></small><% end %></td><td class="actions"><%= link_to "編集", edit_finance_entry_path(entry) %><%= button_to "削除", finance_entry_path(entry), method: :delete, data: { turbo_confirm: "この入出金を削除しますか？" } %></td></tr><% end %>
</tbody></table><% if @records.empty? %><p class="empty">該当する入出金はありません。</p><% end %></section>
<div class="pagination"><% if @page > 1 %><%= link_to "← 前へ", finance_entries_path(request.query_parameters.merge(page: @page - 1)) %><% end %><span><%= @page %>ページ</span><% if @page * 50 < @count %><%= link_to "次へ →", finance_entries_path(request.query_parameters.merge(page: @page + 1)) %><% end %></div>

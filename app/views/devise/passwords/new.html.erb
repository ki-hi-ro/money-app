<div class="finance-heading"><h1>パスワードを再設定</h1></div>
<section class="finance-card form-card">
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
<%= render "devise/shared/error_messages", resource: resource %>
<%= f.label :email, "メールアドレス" %><%= f.email_field :email, autocomplete: "email", required: true %>
<%= f.submit "再設定メールを送信", class: "button" %>
<% end %>
<p><%= link_to "ログインへ", new_session_path(resource_name) %></p></section>

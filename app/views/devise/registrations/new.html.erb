<div class="finance-heading"><h1>アカウントを作成</h1></div>
<section class="finance-card form-card">
<p>登録後に届くメールでメールアドレスを確認すると利用できます。</p>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="finance-form-grid">
    <div><%= f.label :email, "メールアドレス" %><%= f.email_field :email, autocomplete: "email", required: true %></div>
    <div><%= f.label :password, "パスワード（12文字以上）" %><%= f.password_field :password, autocomplete: "new-password", minlength: 12, required: true %></div>
    <div><%= f.label :password_confirmation, "パスワード（確認）" %><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %></div>
  </div>
  <%= f.submit "確認メールを送信", class: "button" %>
<% end %>
<p><%= link_to "ログインへ", new_session_path(resource_name) %> / <%= link_to "確認メールを再送", new_confirmation_path(resource_name) %></p>
</section>

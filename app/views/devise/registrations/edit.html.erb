<div class="finance-heading"><h1>アカウント設定</h1></div>
<section class="finance-card form-card">
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
<%= render "devise/shared/error_messages", resource: resource %>
<div class="finance-form-grid">
<div><%= f.label :email, "メールアドレス" %><%= f.email_field :email, autocomplete: "email", required: true %></div>
<div><%= f.label :password, "新しいパスワード（変更時のみ・12文字以上）" %><%= f.password_field :password, autocomplete: "new-password" %></div>
<div><%= f.label :password_confirmation, "新しいパスワード（確認）" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
<div><%= f.label :current_password, "現在のパスワード" %><%= f.password_field :current_password, autocomplete: "current-password", required: true %></div>
</div>
<% if resource.pending_reconfirmation? %><p>新しいメールアドレスの確認待ちです。</p><% end %>
<%= f.submit "更新", class: "button" %>
<% end %>
</section>
<section class="finance-card"><h2>退会</h2><p>アカウントと家計データをすべて削除します。元に戻せません。</p>
<%= button_to "退会してデータを削除", registration_path(resource_name), method: :delete, data: { turbo_confirm: "すべてのデータを削除して退会しますか？" }, class: "button" %></section>

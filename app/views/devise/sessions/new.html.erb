<div class="finance-heading"><div><p class="eyebrow">MoneyApp</p><h1>ログイン</h1><p class="muted">残高・入出金・これからの見通しを確認しましょう。</p></div></div>
<section class="finance-card form-card">
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="finance-form-grid">
    <div><%= f.label :email, "メールアドレス" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %></div>
    <div><%= f.label :password, "パスワード" %><%= f.password_field :password, autocomplete: "current-password", required: true %></div>
  </div>
  <% if devise_mapping.rememberable? %><p class="form-note"><%= f.check_box :remember_me %> <%= f.label :remember_me, "ログイン状態を保持", style: "display:inline" %></p><% end %>
  <%= f.submit "ログイン", class: "button" %>
<% end %>
<p class="form-note"><%= link_to "アカウントを作成", new_registration_path(resource_name) %> / <%= link_to "パスワードを忘れた場合", new_password_path(resource_name) %> / <%= link_to "確認メールを再送", new_confirmation_path(resource_name) %></p>
</section>
